"terms.title" = "Terms of Service";
"terms.last_updated" = "Last Updated: January 2, 2026";
"terms.acceptance_title" = "Acceptance of Terms";
"terms.acceptance_content" = "Welcome to SnapDrill! By downloading, installing, or using this app, you agree to comply with all terms and conditions of this agreement. If you do not agree to these terms, please do not use this app.";
"terms.service_title" = "Service Description";
"terms.service_content" = "SnapDrill is a personal learning assistant app designed to help users capture, organize, and review knowledge through spaced repetition.\n\nKey features include:\n• Smart scanning & OCR text recognition\n• Question management and categorization\n• Spaced repetition review system\n• Data export (PDF/JSON/CSV)";
"terms.data_storage_title" = "Data Storage";
"terms.data_storage_content" = "SnapDrill does not require an account to use. All data is stored locally on your device by default.\n\nYou are responsible for:\n• Keeping your device secure\n• Regularly backing up important data\n• Note: Uninstalling the app will permanently delete all local data";
"terms.license_title" = "License Grant";
"terms.license_content" = "We grant you a limited, non-exclusive, non-transferable, revocable license to use the SnapDrill app on your personal device.\n\nYou may not:\n• Copy, modify, or reverse-engineer the app\n• Sell, rent, or transfer the app\n• Remove any copyright or proprietary notices\n• Use the app for illegal purposes";
"terms.user_content_title" = "User Content";
"terms.user_content_content" = "All content you create in the app (including text, images, notes, etc.) belongs to you.\n\nYou represent and warrant that:\n• You own or have the necessary rights to the content you upload\n• Your content does not infringe any third-party rights\n• Your content does not contain illegal, harmful, or inappropriate material\n\nWe do not access, use, or share your personal learning content.";
"terms.ip_title" = "Intellectual Property";
"terms.ip_content" = "The SnapDrill app and all its content, features, and functionality (including but not limited to software, text, graphics, logos, icons, and images) are owned by NotBad Labs L.L.C. and are protected by U.S. and international copyright, trademark, and other intellectual property laws.\n\nThe \"SnapDrill\" name and logo are trademarks of NotBad Labs L.L.C. You may not use these trademarks without our prior written permission.";
"terms.disclaimer_title" = "Disclaimer";
"terms.disclaimer_content" = "The SnapDrill app is provided on an \"as is\" and \"as available\" basis, without any express or implied warranties.\n\nWe do not guarantee that:\n• The app will be error-free or uninterrupted\n• Defects will be corrected\n• The app will meet your specific requirements\n• OCR recognition accuracy\n\nYour use of this app is at your own risk.";
"terms.liability_title" = "Limitation of Liability";
"terms.liability_content" = "To the maximum extent permitted by law, NotBad Labs L.L.C. and its affiliates shall not be liable for:\n\n• Any indirect, incidental, special, or consequential damages\n• Data loss or corruption\n• Business interruption or loss of profits\n• Any damages arising from the use or inability to use the app\n\nWe recommend that you regularly back up important data.";
"terms.backup_title" = "Data Backup";
"terms.backup_content" = "While we strive to ensure data security and reliability, we strongly recommend that you:\n\n• Regularly export data using the in-app backup feature\n• Keep copies of important content\n\nWe are not responsible for data loss.";
"terms.changes_title" = "Service Changes and Termination";
"terms.changes_content" = "We reserve the right to modify, suspend, or terminate the app or any of its features at any time without prior notice.\n\nWe may:\n• Update app features\n• Fix bugs and security vulnerabilities\n• Improve user experience\n\nYou may stop using the app and delete it at any time.";
"terms.third_party_title" = "Third-Party Links";
"terms.third_party_content" = "The app may contain links to third-party websites or services. We are not responsible for the content, privacy policies, or practices of these third-party websites. You access third-party links at your own risk.";
"terms.law_title" = "Governing Law";
"terms.law_content" = "This agreement shall be governed by and construed in accordance with the laws of the State of Wyoming, United States, without regard to conflict of law principles. Any disputes arising from this agreement shall first be resolved through good-faith negotiation. If negotiation fails, both parties agree to submit to the jurisdiction of the courts in Wyoming.";
"terms.modification_title" = "Agreement Modifications";
