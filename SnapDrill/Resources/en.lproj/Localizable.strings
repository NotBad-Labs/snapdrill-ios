// MARK: - Privacy Policy

"privacy.title" = "Privacy Policy";
"privacy.last_updated" = "Last Updated: March 2026";
"privacy.intro_title" = "Introduction";
"privacy.intro_content" = "Welcome to SnapDrill! We take your privacy very seriously. This privacy policy explains how we collect, use, store, and protect your personal information. By using the SnapDrill app, you agree to the practices described in this privacy policy.";
"privacy.collection_title" = "Information We Collect";
"privacy.collection_content" = "SnapDrill is an offline-first app. Materials, images, notes, categories, tags, review records, and export files you create in the app are stored locally on your device by default.\n\nThis version does not require an account, does not send material content to NotBad Labs servers, and does not use third-party analytics or crash-reporting SDKs.";
"privacy.icloud_title" = "iCloud Sync (Future Feature)";
"privacy.icloud_content" = "iCloud sync is a planned Pro subscription feature and is not available in the current version.\n\nIf enabled in a future release, sync will use Apple's CloudKit/iCloud service under your Apple ID. NotBad Labs will not operate its own sync server for that data and cannot read your personal iCloud contents. The privacy notice will be updated before this feature ships.";
"privacy.usage_title" = "Data Usage";
"privacy.usage_content" = "SnapDrill processes your local data to provide core app functionality, including capture, organization, review, export, and printing.\n\nIf you contact us by email or through TestFlight feedback, we use only the information you choose to provide to respond to that support request.\n\nWe will not sell your personal information, use your content for advertising, or share your material content with third parties.";
"privacy.security_title" = "Data Security";
"privacy.security_content" = "We take the following measures to protect your data: local storage (data is stored on your device, protected by iOS sandbox), no servers (we do not operate servers to store your data), manual backup (you can export and restore data using the in-app backup feature).";
"privacy.rights_title" = "Your Rights";
"privacy.rights_content" = "You have full control over your data: right of access (you can view all data in the app at any time), right to export (export your data through the Export feature), right to delete (you can delete individual materials or clear all data), right to backup (protect your data through the backup feature).\n\nTo completely delete all data, choose \"Clear All Data\" in Settings or uninstall the app.";
"privacy.third_party_title" = "Third-Party Services";
"privacy.third_party_content" = "SnapDrill uses the following third-party services:\n\n• Apple Vision Framework: used for OCR text recognition, processed entirely on-device. Data never leaves your device.\n\nWe do not use any third-party analytics, crash-reporting, or advertising services. All your data stays local on your device and is never uploaded or used for advertising.";
"privacy.children_title" = "Children's Privacy";
"privacy.children_content" = "SnapDrill is a general-audience productivity tool. It does not provide child accounts, a child mode, or child-directed experiences. This version does not require registration, does not send user material content to NotBad Labs servers, and does not knowingly collect personal information from children under 13. If you believe a child has provided personal information to us without appropriate consent, contact us using the details in this policy and we will handle the request under applicable law.";
"privacy.gdpr_title" = "GDPR Compliance (EU Users)";
"privacy.gdpr_content" = "If you are located in the European Union, you have the right to access, correct, delete, restrict processing, and data portability. Since SnapDrill does not collect or store your data on our servers, you can exercise these rights directly through the app's built-in features.";
"privacy.ccpa_title" = "CCPA Compliance (California Users)";
"privacy.ccpa_content" = "If you are a California resident, you have the right to know the categories of personal information we collect, know whether we sell your personal information (we do not), and delete your personal information. SnapDrill does not sell your personal information or share your material content with third parties.";
"privacy.update_title" = "Privacy Policy Updates";
"privacy.update_content" = "We may update this privacy policy from time to time. If there are significant changes, we will notify you through in-app notifications or by updating the date. We recommend that you regularly review this policy to understand how we protect your information.";
"privacy.contact_title" = "Contact Us";
"privacy.contact_content" = "If you have any questions or concerns about this privacy policy, please contact us:\n\nEmail: hello@notbadhq.com\nIn-app feedback: Settings > About > Feedback & Support\n\nWe will respond to your inquiry within 48 hours.";
"privacy.view_full_version" = "View full version in browser (bilingual)";

