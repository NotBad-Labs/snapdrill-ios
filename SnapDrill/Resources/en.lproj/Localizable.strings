"privacy.title" = "Privacy Policy";
"privacy.last_updated" = "Last Updated: March 2026";
"privacy.intro_title" = "Introduction";
"privacy.intro_content" = "Welcome to SnapDrill! We take your privacy very seriously. This privacy policy explains how we collect, use, store, and protect your personal information. By using the SnapDrill app, you agree to the practices described in this privacy policy.";
"privacy.collection_title" = "Information We Collect";
"privacy.collection_content" = "SnapDrill is a fully offline-first app. We do not actively collect your personal information. All data you create in the app (including questions, images, notes, etc.) is stored on your device.\n\nContent you create: question text, uploaded or captured images, subject categories and tags, review records and progress.\n\nAutomatically collected information: app crash logs (used only to improve app stability), device type and OS version (used for compatibility testing).";
"privacy.icloud_title" = "iCloud Sync (Future Feature)";
"privacy.icloud_content" = "iCloud sync is a planned Pro subscription feature and is not available in the current version. When available in the future:\n\nYour data will be synced between your devices through Apple's iCloud service. All data is stored in your personal iCloud account, and we cannot access your iCloud data. Data transfers are encrypted by Apple. You can turn off iCloud sync at any time in Settings.";
"privacy.usage_title" = "Data Usage";
"privacy.usage_content" = "We use the information collected solely for: providing core functionality (storing and managing your question data), improving the app (analyzing crash logs to fix bugs), user support (responding to your feedback and support requests).\n\nWe will not: sell your personal information, use your data for advertising purposes, or share your learning content with third parties.";
"privacy.security_title" = "Data Security";
"privacy.security_content" = "We take the following measures to protect your data: local storage (data is stored on your device, protected by iOS sandbox), no servers (we do not operate servers to store your data), manual backup (you can export and restore data using the in-app backup feature).";
"privacy.rights_title" = "Your Rights";
"privacy.rights_content" = "You have full control over your data: right of access (you can view all data in the app at any time), right to export (export your data through the Export feature), right to delete (you can delete individual questions or clear all data), right to backup (protect your data through the backup feature).\n\nTo completely delete all data, choose \"Clear All Data\" in Settings or uninstall the app.";
"privacy.third_party_title" = "Third-Party Services";
"privacy.third_party_content" = "SnapDrill uses the following third-party services:\n\n• Apple Vision Framework: used for OCR text recognition, processed entirely on-device. Data never leaves your device.\n• Firebase Analytics (Google): anonymous usage analytics to understand feature usage and improve the product. No personally identifiable information is collected. On iOS, this feature is only enabled after you grant authorization through App Tracking Transparency (ATT).\n• Firebase Crashlytics (Google): crash log collection to identify and fix app stability issues. Only device type, OS version, and crash stack information are collected.\n\nWe do not use any third-party advertising services and will not use your data for advertising purposes.";
"privacy.children_title" = "Children's Privacy";
"privacy.children_content" = "SnapDrill is suitable for users of all ages. We do not knowingly collect personal information from children under 13. If you are a parent or guardian and discover that your child has provided us with personal information without your consent, please contact us and we will take steps to delete the information.";
"privacy.gdpr_title" = "GDPR Compliance (EU Users)";
"privacy.gdpr_content" = "If you are located in the European Union, you have the right to access, correct, delete, restrict processing, and data portability. Since SnapDrill does not collect or store your data on our servers, you can exercise these rights directly through the app's built-in features.";
"privacy.ccpa_title" = "CCPA Compliance (California Users)";
"privacy.ccpa_content" = "If you are a California resident, you have the right to know the categories of personal information we collect, know whether we sell your personal information (we do not), and delete your personal information. SnapDrill does not sell your personal information or share your learning content with third parties.";
"privacy.update_title" = "Privacy Policy Updates";
"privacy.update_content" = "We may update this privacy policy from time to time. If there are significant changes, we will notify you through in-app notifications or by updating the date. We recommend that you regularly review this policy to understand how we protect your information.";
"privacy.contact_title" = "Contact Us";
"privacy.contact_content" = "If you have any questions or concerns about this privacy policy, please contact us:\n\nEmail: hello@notbadhq.com\nIn-app feedback: Settings > About > Feedback & Support\n\nWe will respond to your inquiry within 48 hours.";
"privacy.view_full_version" = "View full version in browser (bilingual)";
