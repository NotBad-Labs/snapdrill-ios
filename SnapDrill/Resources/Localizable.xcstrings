    "Snap a homework or exam page to add the first one here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snap a homework or exam page to add the first one here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "宿題やテストのページを撮影して、最初の間違いを追加しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숙제나 시험지를 촬영해 첫 오답을 추가해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍一页作业或试卷，把第一道错题收进来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拍一頁作業或試卷，把第一道錯題收進來。"
          }
        }
      }
    },
    "Snap a homework or test page instead of copying by hand. SnapDrill cleans annotations right on your iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snap a homework or test page instead of copying by hand. SnapDrill cleans annotations right on your iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手書きで写す代わりにカメラでパシャリ。書き込みを端末内でスッキリ消去します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손으로 베끼는 대신 사진 한 장으로 정리하세요. 기기 내에서 필기를 깔끔하게 지워줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随手拍下作业或试卷错题代替手抄，SnapDrill 在本机为你抹去批改笔迹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨手拍下作業或試卷錯題代替手抄，SnapDrill 在本機為你抹去批改筆跡。"
          }
        }
      }
    },
