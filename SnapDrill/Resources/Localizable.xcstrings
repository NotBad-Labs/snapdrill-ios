    "Auto-clean kept dark ink untouched. Tap Manual Eraser to clean handwritten spots.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-clean kept dark ink untouched. Tap Manual Eraser to clean handwritten spots."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "濃いインクの誤消去を防ぐため強化原画を保持しています。必要に応じて手動消しゴムをご利用ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진한 필기 손상을 막기 위해 보정 원본을 유지했습니다. 필요하면 수동 지우개로 정리하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动去手写已保留深色字迹。如需局部擦除，请点「手动橡皮擦」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動去手寫已保留深色字跡。如需局部擦除，請點「手動橡皮擦」。"
          }
        }
      }
    },
