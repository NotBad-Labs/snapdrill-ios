    "Your unreadable database files will be archived safely inside Application Support (not deleted) before opening a fresh empty notebook.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your unreadable database files will be archived safely inside Application Support (not deleted) before opening a fresh empty notebook."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のデータベースファイルは Application Support 内のアーカイブへ退避（削除されません）され、新しい空のノートが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 DB 파일은 Application Support의 보관 폴더로 안전하게 이동(삭제되지 않음)된 후 새 빈 오답 노트가 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原有数据库文件将被安全移入 Application Support 归档目录（不会删除），随后打开新的空白错题本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原有資料庫檔案將安全移至 Application Support 封存目錄（不會刪除），隨後開啟新的空白錯題本。"
          }
        }
      }
    },
