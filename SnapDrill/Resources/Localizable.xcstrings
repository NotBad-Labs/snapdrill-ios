    "Cannot reorder or remove earlier answer photos while another synced photo is still downloading from iCloud.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot reorder or remove earlier answer photos while another synced photo is still downloading from iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud から同期された別の画像がダウンロード中のため、それより前の解答画像を並べ替えたり削除したりできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에서 동기화된 다른 사진이 아직 다운로드 중이므로 이전 해설 사진의 순서를 변경하거나 삭제할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一张同步的答案图片仍在从 iCloud 下载中，暂无法调整或删除其前面的图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一張同步的答案圖片仍在從 iCloud 下載中，暫時無法調整或刪除其前面的圖片。"
          }
        }
      }
    },
