    "#%@": {},
    "%@": {
      "comment": "A badge showing the number of boxes in a photo.",
      "isCommentAutoGenerated": true
    },
    "%@ · Protected": {
      "comment": "A subtext that shows the number of mistakes in a subject and that indicates that the subject is protected and cannot be deleted.",
      "isCommentAutoGenerated": true
    },
    "%@ pages · %@ questions": {
      "comment": "A subheading that displays the number of pages and questions in a draft capture session. The first argument is the count of pages in the draft. The second argument is the count of questions in the draft.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ pages · %2$@ questions"
          }
        }
      }
    },
    "%@ problems": {
      "comment": "A subheading displaying the number of mistakes in a subject. The argument is the count of mistakes in the subject.",
      "isCommentAutoGenerated": true
    },
    "%@ questions": {
      "comment": "A count of the number of questions that match the current filter criteria.",
      "isCommentAutoGenerated": true
    },
    "%@ still need review": {
      "comment": "A label showing the number of unreviewed questions. The argument is the count of unreviewed questions.",
      "isCommentAutoGenerated": true
    },
