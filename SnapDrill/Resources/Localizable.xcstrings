    "Camera access is currently disabled. You can enable it in Settings or import photos directly from your album.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is currently disabled. You can enable it in Settings or import photos directly from your album."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机权限未开启。你可以前往系统设置开启，或直接从相册导入错题照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機權限未開啟。你可以前往系統設定開啟，或直接從相簿匯入錯題照片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスが無効です。設定から許可するか、アルバムから読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 권한이 꺼져 있습니다. 설정에서 허용하거나 사진 보관함에서 바로 가져오세요."
          }
        }
      }
    },
    "Camera hardware is unavailable on this simulator; use Photos Import below.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera hardware is unavailable on this simulator; use Photos Import below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前模拟器无相机硬件，请使用下方「从相册导入」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前模擬器無相機硬體，請使用下方「從相簿匯入」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレータではカメラを利用できないため、下の写真から読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이터에서는 카메라를 사용할 수 없으니 아래 사진 가져오기를 이용하세요."
          }
        }
      }
    },
