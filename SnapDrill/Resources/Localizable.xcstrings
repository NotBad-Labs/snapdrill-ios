    "Removing a cause or tag only unlinks it from existing mistakes without deleting any questions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing a cause or tag only unlinks it from existing mistakes without deleting any questions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原因やタグを削除しても、問題自体は削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원인이나 태그를 삭제해도 오답 문제 자체는 삭제되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除错因或标签只会解除关联，绝不会删除任何错题本身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除錯因或標籤只會解除關聯，絕不會刪除任何錯題本身。"
