    "Your local database encountered an unexpected storage issue. SnapDrill has paused opening to protect your existing records from being overwritten.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your local database encountered an unexpected storage issue. SnapDrill has paused opening to protect your existing records from being overwritten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地数据库读取遇到异常。为防止覆盖你宝贵的错题记录，SnapDrill 已暂停加载空页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機資料庫讀取遇到異常。為防止覆蓋你寶貴的錯題記錄，SnapDrill 已暫停載入空頁面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルデータベースの読み込みでエラーが発生しました。既存データを保護するため起動を停止しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 데이터베이스를 여는 중 오류가 발생했습니다. 기존 오답 데이터를 보호하기 위해 열기를 중단했습니다."
          }
        }
      }
    },
    "Your mistakes and images always remain editable, printable, and exportable even without a subscription.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your mistakes and images always remain editable, printable, and exportable even without a subscription."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论是否订阅，你保存在本地的所有错题与图片都永久归你所有，可自由查看、打印和导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論是否訂閱，你儲存在本機的所有錯題與圖片都永久歸你所有，可自由查看、列印和匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご契約の有無にかかわらず、端末内の問題・画像はいつでも閲覧・印刷・バックアップ可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독 여부와 관계없이 저장된 모든 오답과 이미지는 언제든 조회·인쇄·백업할 수 있습니다."
          }
        }
      }
    },
