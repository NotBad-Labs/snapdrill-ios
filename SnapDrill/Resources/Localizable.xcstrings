        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」下还有 %lld 道错题，请选择处理方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」下還有 %lld 道錯題，請選擇處理方式。"
          }
        },
