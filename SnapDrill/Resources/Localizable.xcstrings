    "No account required. No ads, no analytics SDKs, and no images are ever uploaded to external servers. EXIF GPS coordinates are stripped locally before saving.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account required. No ads, no analytics SDKs, and no images are ever uploaded to external servers. EXIF GPS coordinates are stripped locally before saving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需注册账号，无广告、无行为追踪 SDK，图片永不上传外部服务器；保存前会在本机剥离 EXIF GPS 位置信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需註冊帳號，無廣告、無行為追蹤 SDK，圖片永不上傳外部伺服器；儲存前會在本機剝離 EXIF GPS 位置資訊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント登録不要・広告なし・外部サーバー送信なし。位置情報（EXIF GPS）も端末内で削除して保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 가입, 광고, 추적 SDK가 없으며 사진은 외부 서버로 절대 전송되지 않습니다. 저장 전 GPS 메타데이터를 자동 삭제합니다."
          }
        }
      }
    },
    "No active Pro subscription was found for this Apple Account.": {
      "extractionState": "manual",
