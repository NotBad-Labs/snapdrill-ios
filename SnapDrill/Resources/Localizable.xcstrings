  "strings": {
    "·": {},
    "· %@": {
      "comment": "A label showing the source of the mistake, displayed in a smaller font below the mistake's title.",
      "isCommentAutoGenerated": true
    },
    "\"%@\" contains %@ mistakes. Choose how to handle them.": {
      "comment": "A confirmation dialog message that appears when the user deletes a subject that contains mistakes. The first argument is the name of the subject. The second argument is the number of mistakes in the subject.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "\"%1$@\" contains %2$@ mistakes. Choose how to handle them."
          }
        }
      }
    },
    "\"%@\" contains %lld mistakes. Choose how to handle them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" contains %lld mistakes. Choose how to handle them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」には %lld 問の問題が含まれています。処理方法を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'에 %lld개의 오답이 있습니다. 처리 방법을 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」下还有 %lld 道错题，请选择处理方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」下還有 %lld 道錯題，請選擇處理方式。"
          }
        }
      }
    },
