    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapDrill uses the camera to photograph homework and exam mistakes entirely on your device."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapDrillは宿題やテストの間違いをカメラで撮影するためにアクセスします。画像はすべて端末内で処理されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapDrill은 숙제와 시험 오답을 촬영하기 위해 카메라에 접근하며, 모든 이미지는 기기 내에서 처리됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapDrill 需要使用相机拍摄作业或试卷错题，所有图像处理均在本地完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapDrill 需要使用相機拍攝作業或考卷錯題，所有影像處理皆於裝置端完成。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
