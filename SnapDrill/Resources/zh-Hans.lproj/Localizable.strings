// MARK: - Privacy Policy

"privacy.title" = "隐私政策";
"privacy.last_updated" = "最后更新日期：2026年3月";
"privacy.intro_title" = "引言";
"privacy.intro_content" = "欢迎使用 SnapDrill！我们非常重视您的隐私。本隐私政策说明了我们如何收集、使用、存储和保护您的个人信息。使用 SnapDrill 应用即表示您同意本隐私政策中描述的做法。";
"privacy.collection_title" = "我们收集的信息";
"privacy.collection_content" = "SnapDrill 是一款完全离线优先的应用，我们不会主动收集您的个人信息。您在应用中创建的所有数据（包括错题内容、图片、笔记等）都存储在您的设备上。\n\n您创建的内容：错题文本、上传或拍摄的图片、学科分类和标签、复习记录和进度。\n\n自动收集的信息：应用崩溃日志（仅用于改进应用稳定性）、设备类型和操作系统版本（用于兼容性测试）。";
"privacy.icloud_title" = "iCloud 同步（未来功能）";
"privacy.icloud_content" = "iCloud 同步是计划中的 Pro 付费功能，当前版本尚未提供。未来启用后：\n\n您的数据将通过 Apple 的 iCloud 服务在您的设备之间同步。所有数据都存储在您的个人 iCloud 账户中，我们无法访问您的 iCloud 数据。数据传输由 Apple 加密保护。您可以随时在设置中关闭 iCloud 同步。";
"privacy.usage_title" = "数据使用";
"privacy.usage_content" = "我们使用收集的信息仅用于：提供核心功能（存储和管理您的错题数据）、改进应用（分析崩溃日志以修复 bug）、用户支持（回应您的反馈和技术支持请求）。\n\n我们不会：出售您的个人信息、将您的数据用于广告目的、与第三方共享您的学习内容。";
"privacy.security_title" = "数据安全";
"privacy.security_content" = "我们采取以下措施保护您的数据：本地存储（数据存储在您的设备上，受 iOS 沙盒保护）、无服务器（我们不运行服务器存储您的数据）、手动备份（您可以通过应用内的备份功能导出和恢复数据）。";
"privacy.rights_title" = "您的权利";
"privacy.rights_content" = "您对自己的数据拥有完全控制权：访问权（您可以随时查看应用中的所有数据）、导出权（通过\"导出\"功能导出您的数据）、删除权（您可以删除单个错题或清空所有数据）、备份权（通过备份功能保护您的数据）。\n\n如需完全删除所有数据，请在设置中选择\"清空所有数据\"或卸载应用。";
"privacy.third_party_title" = "第三方服务";
"privacy.third_party_content" = "SnapDrill 使用以下第三方服务：\n\n• Apple Vision Framework：用于 OCR 文字识别，完全在设备本地处理，数据不离开设备。\n• Firebase Analytics（Google）：匿名使用行为统计，用于了解功能使用情况并改进产品。不收集任何可识别个人身份的信息。在 iOS 上，此功能仅在您通过「应用跟踪透明度（ATT）」授权后才会启用。\n• Firebase Crashlytics（Google）：崩溃日志收集，用于识别和修复应用稳定性问题。仅收集设备类型、操作系统版本及崩溃堆栈信息。\n\n我们不使用任何第三方广告服务，不会将您的数据用于广告目的。";
"privacy.children_title" = "儿童隐私";
"privacy.children_content" = "SnapDrill 适合所有年龄段的用户使用。我们不会有意收集 13 岁以下儿童的个人信息。如果您是家长或监护人，发现您的孩子在未经您同意的情况下向我们提供了个人信息，请联系我们，我们将采取措施删除相关信息。";
"privacy.gdpr_title" = "GDPR 合规（欧盟用户）";
"privacy.gdpr_content" = "如果您位于欧盟，您享有访问、更正、删除、限制处理和数据可携带等权利。由于 SnapDrill 不收集或存储您的数据在我们的服务器上，您可以通过应用内功能直接行使这些权利。";
"privacy.ccpa_title" = "CCPA 合规（加州用户）";
"privacy.ccpa_content" = "如果您是加州居民，您享有了解我们收集的个人信息类别、了解我们是否出售您的个人信息（我们不会）、删除您的个人信息等权利。SnapDrill 不会出售您的个人信息，也不会与第三方共享您的学习内容。";
"privacy.update_title" = "隐私政策更新";
"privacy.update_content" = "我们可能会不时更新本隐私政策。如有重大变更，我们将通过应用内通知或更新日期告知您。建议您定期查看本政策以了解我们如何保护您的信息。";
"privacy.contact_title" = "联系我们";
"privacy.contact_content" = "如果您对本隐私政策有任何疑问或顾虑，请通过以下方式联系我们：\n\n邮箱：hello@notbadhq.com\n应用内反馈：设置 → 关于 → 反馈与支持\n\n我们将在 48 小时内回复您的询问。";
