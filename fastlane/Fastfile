
default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # 1. 确保 git 状态干净
    ensure_git_status_clean

    # 2. 增加 Build Number (需要先在 Xcode 设置 Versioning System 为 Apple Generic)
    increment_build_number(xcodeproj: "SnapDrill.xcodeproj")

    # 3. 运行测试（AGENTS.md 门禁：必须 AllTests scheme + AllTests testPlan，
    #    SnapDrill scheme 不含 SPM 包测试）
    run_tests(
      scheme: "AllTests",
      testplan: "AllTests"
    )

    # 4. 编译 App（编译用 SnapDrill scheme — 它是 app target）
    build_app(
      scheme: "SnapDrill",
      export_method: "app-store"
    )

    # 5. 上传到 TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end
