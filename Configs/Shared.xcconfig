// App Identity
PRODUCT_NAME = SnapDrill
PRODUCT_BUNDLE_IDENTIFIER = com.snapdrill.global
MARKETING_VERSION = 1.1.0
CURRENT_PROJECT_VERSION = 6

// Export Compliance：仅用标准/豁免加密（HTTPS），声明后免每次 TestFlight 上传的出口合规问询
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO

// Swift
SWIFT_VERSION = 6.3
SWIFT_STRICT_CONCURRENCY = complete
OTHER_SWIFT_FLAGS = $(inherited) -default-isolation MainActor -enable-upcoming-feature NonisolatedNonsendingByDefault -enable-upcoming-feature InferIsolatedConformances

// Deployment
IPHONEOS_DEPLOYMENT_TARGET = 26.0

// Compiler
GCC_TREAT_WARNINGS_AS_ERRORS = YES // Enterprise Standard: Zero Tolerance
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
