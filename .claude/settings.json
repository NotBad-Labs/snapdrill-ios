{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat .claude/compact-reminder.md"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/log-file-change.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/swift-autolint.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-merge-checkpoint.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-dangerous-bash.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/premerge-checklist.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/prepush-lint.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/long-session-guard.sh"
          }
        ]
      }
    ]
  }
}
